---
import{getCollection}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import{site}from"../../data/site";const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"Yollo AI comparisons and safety guides",url:`${site.url}/blog/`,description:"Independent Yollo AI comparisons, safety checklists, and AI girlfriend research.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="Yollo AI Blog: Reviews, Comparisons & Safety" description="Independent Yollo AI guides covering roleplay, character creation, images, video, privacy, regions, pricing, Character.AI, Janitor AI, and alternatives." keywords={["Yollo AI blog","Yollo AI review","Yollo AI comparison","AI roleplay alternatives","Yollo AI safety"]} jsonLd={jsonLd}><section class="page-hero"><div class="ambient-orb"></div><span>YOLLO AI FIELD NOTES</span><h1>Better stories.<br/>Smarter comparisons.</h1><p>Original decision guides for Yollo AI and the wider character roleplay and visual-generation category.</p></section><section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section></BaseLayout>

