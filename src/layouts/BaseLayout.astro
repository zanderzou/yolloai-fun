---
import Analytics from "../components/Analytics.astro";
import { getCollection } from "astro:content";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { a11y, languageAlternates, locales, type Locale } from "../data/locales";
import { site } from "../data/site";
import "../styles.css";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  locale?: Locale;
  keywords?: string[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title, description, type = "website", locale = "", keywords = [],
  noindex = false, publishedTime, modifiedTime, jsonLd,
} = Astro.props;
const current = locales.find((entry) => entry.slug === locale);
const lang = current?.lang ?? "en";
const dir = lang === "ar" ? "rtl" : "ltr";
const ogLocale: Record<string, string> = {
  en: "en_US", ja: "ja_JP", ko: "ko_KR", "zh-Hant": "zh_TW",
  es: "es_ES", "pt-BR": "pt_BR", ru: "ru_RU", de: "de_DE",
  fr: "fr_FR", ar: "ar_SA",
};
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url).toString();
const alternates = noindex ? [] : languageAlternates(pathname);
const image = `${site.url}/assets/yollo-user-knit-editorial.jpg`;
const posts = (await getCollection("blog")).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const robots = noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta name="msvalidate.01" content="56B74B6B9E884918F4F18C05D7E2A1F4" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((entry) => <link rel="alternate" hreflang={entry.lang} href={new URL(entry.href, site.url).toString()} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, site.url).toString()} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="theme-color" content="#141318" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Yollo AI character roleplay editorial image" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">{locale ? a11y[locale].skip : "Skip to content"}</a>
    <Header locale={locale} pathname={noindex ? "/" : pathname} />
    <main id="main"><slot /></main>
    <Footer locale={locale} posts={posts} />
    <script is:inline src="/assets/main.js"></script>
    <Analytics locale={locale} />
  </body>
</html>
