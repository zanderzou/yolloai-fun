---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { comparisonArticles } from "../data/localized-articles";
import { localizedHome } from "../data/localized-home";
import { comparisons, routeFor, ui, type Locale } from "../data/locales";
import { site } from "../data/site";
interface Props { posts: CollectionEntry<"blog">[]; locale?: Locale | ""; }
const { posts, locale = "" } = Astro.props;
const label = locale ? ui[locale] : undefined;
const home = routeFor(locale);
---
<footer><div class="footer-grid">
  <div>
    <a class="brand" href={home}><span class="brand-icon">Y</span><strong>Yollo<span>AI</span></strong></a>
    <p>{locale ? `${label!.independent} ${localizedHome[locale].intro}` : "Independent research on Yollo AI roleplay, characters, image and video generation, privacy, regional availability, pricing, safety, and alternatives."}</p>
  </div>
  <div>
    <h3>{label?.features ?? "Explore"}</h3>
    <a href={`${home}#features`}>{label?.features ?? "Yollo AI features"}</a>
    <a href={`${home}#compare`}>{label?.compare ?? "Roleplay comparisons"}</a>
    <a href={`${home}#privacy`}>{label?.privacy ?? "Privacy checklist"}</a>
    <a href={site.officialUrl} rel="noopener" target="_blank">{label?.official ?? "Official website"} <Icon name="arrow" /></a>
  </div>
  <div>
    <h3>{label?.allArticles ?? "Latest guides"}</h3>
    {locale
      ? comparisons.slice(0, 3).map((entry) => <a href={routeFor(locale, `blog/${entry.slug}`)}>{comparisonArticles[locale][entry.key].title}</a>)
      : posts.slice(0, 3).map((post) => <a href={`/blog/${post.id}/`}>{post.data.title}</a>)}
  </div>
  <div>
    <h3>{label?.about ?? "Information"}</h3>
    <a href={routeFor(locale, "about")}>{label?.about ?? "About"}</a>
    <a href={routeFor(locale, "privacy")}>{label?.privacy ?? "Privacy"}</a>
    <a href={routeFor(locale, "terms")}>{label?.terms ?? "Terms"}</a>
    <a href={routeFor(locale, "editorial-policy")}>{label?.editorial ?? "Editorial policy"}</a>
    <a href={routeFor(locale, "contact")}>{label?.contact ?? "Contact"}</a>
  </div>
</div><div class="footer-bottom">
  <span>© <span data-year>2026</span> Yollo AI</span>
  <span>{label?.independent ?? "Independent · Not affiliated with Yollo AI"}</span>
  <span>{label?.regionNote ?? "Adults only · No chat data collected"}</span>
</div></footer>
